
{
  "name": "within-me",
  "version": "1.0.0",
  "private": true,
  "description": "Within Me - A journey into the mind",
  "author": "Ahmed Hadjam",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/android": "^8.6.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.ahmedhadjam.withinme",
    "productName": "Within Me",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
